# ---- Live trading only (Angel One SmartAPI). Paper mode and backtests need none of these. ----
# Create the app at https://smartapi.angelone.in (Trading API type). API key = "Private key".
ANGEL_API_KEY=
# Your Angel One client code (the login id, e.g. A123456).
ANGEL_CLIENT_CODE=
# Your 4-digit trading MPIN (SmartAPI logs in with MPIN, not the password).
ANGEL_MPIN=
# TOTP secret from https://smartapi.angelone.in/enable-totp (the base32 string under the QR code).
ANGEL_TOTP_SECRET=

# ---- Safety ----
# Must be exactly "I UNDERSTAND REAL MONEY" for --mode=live to place real orders.
LIVE_TRADING_ACK=
# Set to 1 to stop all trading at once (same as `npm run kill`).
TRADING_KILL=
